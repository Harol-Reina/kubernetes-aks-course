{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "created-via-api",
    "labels": {
      "method": "rest-api"
    }
  },
  "spec": {
    "containers": [
      {
        "name": "nginx",
        "image": "nginx",
        "ports": [
          {
            "containerPort": 80
          }
        ]
      }
    ]
  }
}
